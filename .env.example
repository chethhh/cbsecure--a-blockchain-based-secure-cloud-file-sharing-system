# Optional root-level environment when running the API from the project root.
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=

# Email/password sign-in uses Resend's HTTPS API. Keep the API key server-side.
RESEND_API_KEY=
RESEND_FROM_EMAIL="CB SECURE <otp@your-verified-domain.com>"

# Optional Pinata IPFS pinning. Without this, ciphertext is kept by the local
# development adapter under backend/data/storage.
PINATA_JWT=

