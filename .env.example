# Optional root-level environment when running the API from the project root.
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=

# Email/password sign-in requires real SMTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cbsecure@gmail.com
SMTP_PASS=
SMTP_FROM=CB SECURE <cbsecure@gmail.com>

# Optional Pinata IPFS pinning. Without this, ciphertext is kept by the local
# development adapter under backend/data/storage.
PINATA_JWT=

