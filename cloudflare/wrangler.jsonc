{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cb-secure-api",
  "main": "../backend/src/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "vars": {
    "CF_WORKERS": "true",
    "CF_D1_ACTIVE": "true",
    "NODE_ENV": "production",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587"
  },
  "durable_objects": {
    "bindings": [
      { "name": "API_COORDINATOR", "class_name": "ApiCoordinator" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cb-secure-db",
      "database_id": "93a411cf-bdaf-4e23-be4a-067161fc0aae",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApiCoordinator"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
