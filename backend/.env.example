PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
# Set this to the first Admin's verified email before registration.
INITIAL_ADMIN_EMAIL=
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=

# Required for real email OTPs. Keep the API key private and use a sender
# address on a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="CB SECURE <otp@your-verified-domain.com>"

# Optional Pinata IPFS pinning. Empty uses the local ciphertext adapter.
PINATA_JWT=

